{
  "name": "adaptivess-reference",
  "source": {
    "libraryRoot": "./data/library",
    "keyOhlc": "SYMBOL_price_4hr",
    "barHours": 4
  },
  "periods": {
    "train": { "start": "2022-07-01T00:00:00", "end": "2025-10-06T00:00:00" },
    "backtest": { "start": "2025-10-06T00:00:00", "end": "2026-07-31T00:00:00" },
    "holdoutFrom": "2026-08-01T00:00:00"
  },
  "eval": {
    "ledgerDir": "./data/ledger/eval",
    "replicaSeeds": 2,
    "warmupDays": 180,
    "cadenceDays": 7,
    "phases": [0, 1, 2, 3, 4, 5, 6],
    "horizons": [1, 3, 7, 14, 30],
    "nullDraws": 64,
    "seed": 20261110,
    "fitEnd": { "long": "2025-04-08T00:00:00", "short": "2025-10-06T00:00:00" },
    "limits": { "monthlyOrders": 400, "peakHold": 50 },
    "capital": 1000,
    "uPerOrder": 20,
    "timeoutSec": 900
  },
  "score": {
    "ladder1": { "S": 15, "nullP": 0.05 },
    "ladder2": { "freshMin": 10, "worstPhaseMin": 5 },
    "ladder3": { "monthlyOrders": 300, "peakHold": 30 },
    "freqBands": [100, 250]
  },
  "backtest": {
    "enabled": false,
    "privateRoot": "./private",
    "minLadder": 0,
    "rule": { "meanMin": 0, "worstPhaseMin": 0 },
    "replicas": 3,
    "nullDraws": 64,
    "timeoutSec": 1200
  },
  "rsi": {
    "root": "./rsi",
    "nodesPerRound": 5,
    "parallelNodes": 5,
    "roundsPerRun": 1,
    "maxArmsPerNode": 4,
    "mechanicalDream": false
  },
  "records": {
    "nodeDir": "./rsi/records/nodes",
    "dreamDir": "./rsi/records/dreams",
    "trashDir": "./rsi/records/trash",
    "workDir": "./rsi/work",
    "toolboxDir": "./rsi/toolbox"
  },
  "agents": {
    "node": {
      "kind": "opencode",
      "id": "ocgo:opencode-go/deepseek-v4.1-flash",
      "variant": "high",
      "timeoutMin": 120,
      "fallback": [{ "kind": "opencode", "id": "oc:opencode/deepseek-v4.1-flash-free", "variant": "high" }]
    },
    "dream": {
      "kind": "claude",
      "model": "claude-opus-5-5",
      "effort": "xhigh",
      "timeoutMin": 240
    }
  },
  "dispatch": {
    "skillsRoot": "",
    "envFile": "./.env"
  },
  "resources": { "cpuMax": 70, "ramUsedMaxGB": 110, "cpuStart": 55, "ramStartGB": 102, "sampleSec": 5, "pollSec": 10, "maxWaitMin": 30 }
}
